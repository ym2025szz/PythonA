<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/PythonATheme">
        <processes>
            <process>
                <deny-permission android:name="android.permission.INTERNET" />
            </process>
            <process android:process=":runtime">
                <deny-permission android:name="android.permission.INTERNET" />
            </process>
            <process android:process=":language">
                <deny-permission android:name="android.permission.INTERNET" />
            </process>
            <process android:process=":dsh">
                <allow-permission android:name="android.permission.INTERNET" />
            </process>
        </processes>
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".RuntimeHostService"
            android:exported="false"
            android:process=":runtime" />
        <service
            android:name=".LanguageHostService"
            android:exported="false"
            android:process=":language" />
        <service
            android:name=".DshHostService"
            android:exported="false"
            android:process=":dsh" />
        <receiver
            android:name=".RuntimeProcessRestartReceiver"
            android:exported="false"
            android:process=":runtime" />
        <receiver
            android:name=".LanguageProcessRestartReceiver"
            android:exported="false"
            android:process=":language" />
        <receiver
            android:name=".DshProcessRestartReceiver"
            android:exported="false"
            android:process=":dsh" />
    </application>
</manifest>
